{
  "manifest_version": 3,
  "name": "网申助手 · 招聘表单自动填充",
  "version": "0.1.0",
  "description": "本地保存个人资料，智能识别招聘网申页面表单，逐字段预览确认后自动填充。所有数据仅保存在本机。",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "网申助手"
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/storage.js",
        "lib/fields.js",
        "content/detector.js",
        "content/filler.js",
        "content/panel.js",
        "content/content.js"
      ],
      "css": ["content/page.css"],
      "run_at": "document_idle"
    }
  ]
}
